# Ledgerlight Environment Configuration
NODE_ENV=development

# Database Configuration (PostgreSQL in Docker, SQLite locally)
DATABASE_URL=postgresql://ledgerlight:ledgerlight_secret@localhost:5432/ledgerlight_db
# For local Python dev without Docker:
# DATABASE_URL=sqlite:///./ledgerlight.db

POSTGRES_USER=ledgerlight
POSTGRES_PASSWORD=ledgerlight_secret
POSTGRES_DB=ledgerlight_db

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# API & Frontend URLs
API_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security (Change in production)
SECRET_KEY=ledgerlight_dev_secret_key_change_in_production_32_bytes!
